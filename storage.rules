rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isIngelogd() {
      return request.auth != null;
    }

    // Rol bij voorkeur uit de custom claim (geen cross-service call); val terug
    // op een firestore.get() zolang de token nog geen claim bevat (zie de Cloud
    // Function syncRolClaim en de toelichting in firestore.rules).
    function isBeheerder() {
      return isIngelogd() && (
        request.auth.token.rol in ['admin', 'bestuurslid']
        || (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.rol in ['admin', 'bestuurslid']
        )
      );
    }

    function isAfbeelding() {
      return request.resource.contentType.matches('image/.*');
    }

    function isEigenProfiel(uid) {
      return isIngelogd() && request.auth.uid == uid;
    }

    // club-logo.* is publiek leesbaar (PWA-icoon zonder auth-token);
    // overige logo's enkel voor ingelogde gebruikers.
    match /logos/{file} {
      allow read: if file.matches('club-logo\\..*') || isIngelogd();
      allow write: if isBeheerder()
        && request.resource.size < 2 * 1024 * 1024
        && isAfbeelding();
      allow delete: if isBeheerder();
    }

    // Documenten — beheerd door Documenten-pagina (bestaande feature)
    match /documents/{file} {
      allow read: if isIngelogd();
      allow write: if isBeheerder() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isBeheerder();
    }

    // Examen-documenten — beheerd door Examens-pagina
    match /events/{eventId}/{file=**} {
      allow read: if isIngelogd();
      allow write: if isBeheerder() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isBeheerder();
    }

    // Profielfoto's — elke gebruiker beheert enkel zijn eigen foto, admins mogen verwijderen.
    match /profielen/{uid} {
      allow read: if isIngelogd();
      allow write: if isEigenProfiel(uid) && isAfbeelding() && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isEigenProfiel(uid) || isBeheerder();
    }

    // Bestuursverslagen en -documenten — vertrouwelijk. In tegenstelling tot
    // /documents/ (leesbaar voor elk ingelogd lid) is dit enkel toegankelijk
    // voor bestuur. Pad: bestuur/{vergaderingId}/... en bestuur/documenten/...
    match /bestuur/{path=**} {
      allow read: if isBeheerder();
      allow write: if isBeheerder() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isBeheerder();
    }

    // Default: niets toelaten
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
