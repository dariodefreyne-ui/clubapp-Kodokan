rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isIngelogd() {
      return request.auth != null;
    }

    // Rolcheck die NOOIT op een verouderde/ontbrekende custom claim blijft hangen.
    // De custom claim (request.auth.token.rol, gezet door Cloud Function
    // syncRolClaim) wordt eerst geprobeerd: klopt die, dan is er geen extra
    // Firestore-read nodig. Klopt de claim niet (bv. een stale 'lid'-claim van
    // vóór een rolwijziging, of nog geen claim na de eerste login), dan valt de
    // check terug op het user-document — exact de bron die de app zelf gebruikt.
    // Hierdoor kan de UI nooit admin tonen terwijl de rules toegang weigeren.
    function rolIs(r) {
      return request.auth.token.rol == r
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == r
        );
    }

    function isAdmin() {
      return isIngelogd() && rolIs('admin');
    }

    function isBestuurslid() {
      return isIngelogd() && (rolIs('bestuurslid') || rolIs('admin'));
    }

    // Backwards-compatibel: alles wat vroeger isBeheerder() gebruikte
    // werkt nu voor admin én bestuurslid
    function isBeheerder() {
      return isBestuurslid();
    }

    function isTrainer() {
      return isIngelogd() && (rolIs('trainer') || isBestuurslid());
    }

    function isAssistent() {
      return isIngelogd() && rolIs('assistent');
    }

    function isEigenProfiel(uid) {
      return isIngelogd() && request.auth.uid == uid;
    }

    function isLinkedMember(memberId) {
      return isIngelogd() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedMemberId == memberId;
    }

    // Ouder met een goedgekeurde gezinslink mag het member-document van het kind lezen
    // en beperkt updaten (zelfde rechten als een gekoppeld lid).
    function isBeheerderVan(memberId) {
      return isIngelogd() &&
        get(/databases/$(database)/documents/members/$(memberId)).data.get('beheerderUids', []).hasAny([request.auth.uid]);
    }

    match /users/{uid} {
      // Eigen profiel lezen: altijd. Trainer+ mag alle profielen lezen (voor ledenlijsten).
      allow read: if isEigenProfiel(uid) || isTrainer();
      // Aanmaken: eigen account via registratie-flow, of admin.
      allow create: if isAdmin() || isEigenProfiel(uid);
      // Admin mag onbeperkt updaten (rol-wijzigingen, audit-correcties, enz.)
      allow update: if isAdmin();
      // Eigenaar mag profiel bijwerken, maar niet beveiligde velden.
      // linkedMemberId wordt server-side gezet door de Cloud Function koppelLidViaEmail.
      // groepen is normaal admin-only, maar mag éénmalig gezet worden bij het voltooien
      // van onboarding (transitie onboardingVoltooid: false → true).
      allow update: if isEigenProfiel(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rol', 'aangemaakt', 'linkedMemberId']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groepen']) ||
          (resource.data.onboardingVoltooid == false && request.resource.data.onboardingVoltooid == true)
        );
      // Verwijderen: enkel admin.
      allow delete: if isAdmin();
    }

    match /members/{id} {
      // Trainer+ leest alles; een lid leest zijn eigen gekoppelde lid; een ouder
      // leest het lid-document van zijn beheerde kinderen; e-mailmatch voor initiële koppeling.
      allow read: if isTrainer() || isLinkedMember(id) || isBeheerderVan(id)
        || (isIngelogd() && resource.data.email == request.auth.token.email);
      // Bestuur (admin + bestuurslid) mag aanmaken en onbeperkt updaten.
      // Firestore evalueert allow-regels als OR: deze regel dekt beheerders
      // volledig. De regels hieronder gelden daarom enkel voor trainers (geen
      // beheerder) en gekoppelde leden — de !isBeheerder()/veldbeperkingen zijn
      // bewust enkel op hén van toepassing.
      allow create: if isBeheerder();
      allow update: if isBeheerder();
      // Hard-delete enkel voor admin; bestuur deactiveert via update actief:false (soft-delete)
      allow delete: if isAdmin();
      // Trainers (zonder beheerdersrol) mogen updaten, maar niet de financiële/audit-velden
      allow update: if isTrainer() && !isBeheerder() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['bijdrageBetaald', 'bijdrageVervaldatum', 'lidnummer',
                   'vergunningsnummer', 'ingeschrevenJaar']);
      // Leden mogen enkel hun eigen contact- en medische gegevens updaten.
      // Ouders mogen dezelfde velden van hun beheerde kinderen updaten.
      allow update: if (isLinkedMember(id) || isBeheerderVan(id)) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['naam', 'geboortedatum', 'gordel', 'groepen', 'lidnummer',
                   'ingeschrevenJaar', 'bijdrageBetaald', 'bijdrageVervaldatum',
                   'actief', 'vergunningsnummer']);

      match /attendance/{doc} {
        allow read: if isIngelogd();
        allow write: if isTrainer();
      }
    }

    // Collection-group lezen van álle attendance-subcollecties (gebruikt door
    // Rapporten voor één query i.p.v. N+1). De geneste members/.../attendance
    // regel dekt geen collection-group queries, dus dit aparte recursieve pad is
    // nodig. Enkel trainer+ (Rapporten is bestuur-gated in de UI).
    match /{path=**}/attendance/{attId} {
      allow read: if isTrainer();
    }

    // Collection-group voor registrations (Klassement: één query i.p.v. N+1 per event).
    // Zelfde redenering als attendance-collection-group hierboven.
    match /{path=**}/registrations/{doc} {
      allow read: if isIngelogd();
    }

    // Collection-group voor trainingen/.../technieken (Rapporten > technieken-tab).
    // Zelfde redenering als attendance hierboven.
    match /{path=**}/technieken/{tid} {
      allow read: if isTrainer();
    }

    match /groepen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /trainingen/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();
      // Assistent mag zich enkel zelf koppelen: alleen het lesgevers-veld wijzigen.
      allow update: if isAssistent() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lesgevers', 'updatedAt', 'updatedBy']);

      match /technieken/{tid} {
        allow read: if isIngelogd();
        allow write: if isTrainer();
      }

      match /beschikbaarheid/{uid} {
        allow read: if isIngelogd();
        allow write: if isBeheerder() || isEigenProfiel(uid);
      }
    }

    match /lesgevers/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /technieken/{id} {
      allow read: if isIngelogd();
      allow create: if isBeheerder();
      allow update: if isTrainer();
      allow delete: if isBeheerder();
    }

    match /examens/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();
    }

    match /events/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();

      match /registrations/{doc} {
        allow read: if isIngelogd();
        allow write: if isTrainer();
      }

      match /{subcol}/{doc} {
        allow read: if isIngelogd();
        allow write: if isTrainer();
      }
    }

    match /inschrijvingen/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();
      // Ouder mag inschrijving aanmaken voor een beheerd kind (memberId moet in beheerMemberIds staan)
      allow create: if isIngelogd() &&
        request.resource.data.memberId != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('beheerMemberIds', []).hasAny([request.resource.data.memberId]);
    }

    match /evenementen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();

      // Inschrijvingen voor clubevenementen. Document-id = memberId.
      // Iedereen ingelogd mag de lijst lezen (deelnemerslijst); een gekoppeld
      // lid mag enkel zijn eigen inschrijving aanmaken/wijzigen/verwijderen;
      // beheer mag voor iedereen in-/uitschrijven.
      match /registrations/{memberId} {
        allow read: if isIngelogd();
        // Trainer+ beheert inschrijvingen voor iedereen (zoals bij
        // wedstrijden/examens); een gekoppeld lid beheert enkel zichzelf.
        allow write: if isTrainer() || isLinkedMember(memberId);
      }
    }

    match /communications/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();
    }

    match /documents/{id} {
      allow read: if isIngelogd();
      allow write: if isTrainer();
    }

    match /products/{id} {
      allow read: if isIngelogd();
      allow create: if isBeheerder() || (isTrainer() && request.resource.data.tweedehands == true);
      // Stock mag nooit negatief worden
      allow update: if isTrainer() &&
        (request.resource.data.stock == null || request.resource.data.stock >= 0);
      allow delete: if isBeheerder();
    }

    match /sales/{id} {
      allow read: if isTrainer();
      allow create: if isTrainer();
      allow update: if isBeheerder();
      allow delete: if isBeheerder();
    }

    match /verkoopmomenten/{id} {
      allow read: if isTrainer();
      allow create: if isBeheerder();
      allow update: if isBeheerder();
      allow delete: if isBeheerder();
    }

    match /tarieven/{id} {
      allow read: if isTrainer();
      allow write: if isBeheerder();
    }

    match /tarieftypes/{id} {
      allow read: if isTrainer();
      allow write: if isBeheerder();
    }

    match /uitbetalingsperiodes/{id} {
      allow read: if isTrainer();
      allow write: if isBeheerder();
    }

    match /instellingen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    // Configureerbare lijsten — alleen lezen voor alle ingelogden, schrijven enkel bestuur
    match /categorieen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /lesgeverTypes/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /gordels/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /communicatieCategorieen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /techniekCategorieen/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /mailTemplates/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    // Club-instellingen (naam, logo, …) zijn nodig op de loginpagina en onboarding
    // vóórdat de gebruiker ingelogd is — daarom publiek leesbaar.
    match /settings/club {
      allow read: if true;
      allow write: if isBeheerder();
    }

    match /settings/{id} {
      allow read: if isIngelogd();
      allow write: if isBeheerder();
    }

    match /notificationTokens/{token} {
      // Lezen: enkel beheerders (admin/bestuurslid) voor PushStatusDashboard.
      // Device-tokens zijn gevoelig; trainers hebben dit dashboard niet nodig.
      allow read: if isBeheerder();
      allow create: if isIngelogd() && request.resource.data.uid == request.auth.uid;
      allow update: if isIngelogd() && resource.data.uid == request.auth.uid;
      allow delete: if isIngelogd() && resource.data.uid == request.auth.uid;
    }

    match /stockAlerts/{id} {
      allow read: if isTrainer();
      allow create, update, delete: if isBeheerder();
    }

    match /mail/{document} {
      allow create: if isBeheerder();
      allow read: if false;
      allow update, delete: if false;
    }

    match /trainerReminderTriggers/{docId} {
      allow create: if isBeheerder();
      allow read: if false;
    }

    match /pushTriggers/{docId} {
      allow create: if isTrainer();
      allow read, update, delete: if false;
    }

    match /notificatieLogs/{docId} {
      // Audit-trail van elke push-poging. Admin/bestuur leest voor diagnose.
      allow read: if isBeheerder();
      allow write: if false;
    }

    match /pushFailures/{docId} {
      // Push-triggers die na maximale pogingen niet konden worden verstuurd.
      allow read: if isBeheerder();
      allow write: if false;
    }

    match /auditLogs/{docId} {
      // Audit-log: alleen leesbaar door beheerders, schrijven via Cloud Function.
      allow read: if isBeheerder();
      allow write: if false;
    }

    match /migrationTriggers/{docId} {
      // Enkel admin mag migraties triggeren
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ─── BESTUUR ─────────────────────────────────────────────────────────────
    // Vertrouwelijke bestuursdata: enkel admin/bestuurslid (isBestuurslid() dekt
    // beide). Verwijderen van een vergadering blijft voorbehouden aan admin.
    match /bestuursVergaderingen/{id} {
      allow read: if isBestuurslid();
      allow create, update: if isBestuurslid();
      allow delete: if isAdmin();
    }

    match /bestuursActiepunten/{id} {
      allow read: if isBestuurslid();
      allow create, update, delete: if isBestuurslid();
    }

    match /bestuursDocumenten/{id} {
      allow read: if isBestuurslid();
      allow create, update, delete: if isBestuurslid();
    }

    // ─── GEZINSLINKS ─────────────────────────────────────────────────────────
    // Ouder maakt zelf een aanvraag aan; admin keurt goed of af.
    // Kind < 18 kan de koppeling niet verwijderen — enkel admin mag deleten.
    match /gezinslinks/{linkId} {
      allow create: if isIngelogd() && request.resource.data.ouderUid == request.auth.uid;
      allow read: if isIngelogd() && (resource.data.ouderUid == request.auth.uid || isBeheerder());
      allow update: if isBeheerder();
      allow delete: if isAdmin();
    }

  }
}
